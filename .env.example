# Noodlr Memory service configuration. Copy to ".env" and edit.
# ".env" is gitignored. Never commit real keys.

# --- server ---
#
# Pick the recipe that matches your setup; the defaults below are recipe 1.
#
#   1. Everything on one machine (Foundry, this service, and the GM's browser).
#      HOST=127.0.0.1, no socket. The module uses the direct URL http://127.0.0.1:3010.
#
#   2. Foundry and this service on one Linux box, players/GM connecting over the network
#      (the common self-hosted setup). Keep HOST=127.0.0.1 and ALSO set the socket below, then
#      have the web server that already serves Foundry proxy a path to it — see DEPLOYMENT.md §6.
#      In the module choose "Behind the Foundry server" and enter that path, e.g. /memory.
#      Do NOT set HOST=0.0.0.0 for this: the proxy reaches the service over the socket, so a
#      network-facing port would only add an unencrypted way in, guarded by the secret alone.
#
#   3. This service on a different machine from Foundry, no proxy in front of it.
#      HOST=0.0.0.0 so it answers on the network, a strong secret, and a firewall rule limiting
#      the port to the machines that need it. There is no TLS on this path: browsers also block
#      plain HTTP calls from an HTTPS Foundry page, so proxying (recipe 2) is the better answer
#      whenever it's available.
#
# Bind address. 127.0.0.1 serves only this machine; 0.0.0.0 answers on every interface.
NOODLR_MEMORY_HOST=127.0.0.1
# Set to 0 to run without a TCP port at all (Unix socket only).
NOODLR_MEMORY_PORT=3010
# Optional: ALSO listen on a Unix domain socket, at the same time as the port above (Linux/macOS;
# ignored on Windows). This is how a reverse proxy on this machine should connect. The proxy user
# must be able to reach it: keep the socket dir traversable and add that user to this service's
# group (mode 660), or use 666 to let any local account connect (they still need the secret).
# systemd RuntimeDirectory=noodlr-memory gives you /run/noodlr-memory.
# NOODLR_MEMORY_SOCKET=/run/noodlr-memory/noodlr-memory.sock
# NOODLR_MEMORY_SOCKET_MODE=660
# Shared secret. The Foundry module must send this as the x-noodlr-secret header.
# STRONGLY recommended. Leave blank ONLY for isolated local testing.
NOODLR_MEMORY_SECRET=
# Max request body size in MB (ingestion payloads can be large).
NOODLR_MEMORY_MAX_BODY_MB=32

# --- vector store backend: lancedb | vectra | qdrant | chroma ---
# lancedb = embedded, in-process (no external service, no Python). Recommended default.
#           Writes Lance files under LANCEDB_URI. Uses the @lancedb/lancedb native module.
# vectra  = zero external service, JSON files under DATA_DIR (tiny/simple fallback).
# qdrant  = needs a running/hosted Qdrant (QDRANT_URL).
# chroma  = needs a running Chroma server (CHROMA_URL).
VECTOR_BACKEND=lancedb
NOODLR_MEMORY_DATA_DIR=./data

# LanceDB data directory. Leave unset to keep everything self-contained under
# <DATA_DIR>/lancedb (recommended — one folder to back up, created automatically).
# Only set this to point at an external/existing store. noodlr-memory must be the SOLE
# writer of whatever directory you use (don't also run a separate LanceDB server on it).
# LANCEDB_URI=/opt/lancedb_data

CHROMA_URL=http://localhost:8000
# CHROMA_AUTH_TOKEN=

QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# --- default embedding provider (can be overridden per request by the module) ---
# openrouter   -> https://openrouter.ai/api/v1 (+ EMBED_API_KEY)
# custom       -> any OpenAI-compatible /v1/embeddings (Ollama, vLLM, llama.cpp, LM Studio)
#                 set EMBED_BASE_URL (e.g. http://localhost:11434/v1) and EMBED_MODEL
# transformers -> fully local, in-process (Transformers.js). No external server or key.
#                 Needs the optional @huggingface/transformers dep; EMBED_MODEL is a
#                 HuggingFace id (default Xenova/all-MiniLM-L6-v2), downloaded + cached once.
# mock         -> deterministic local vectors, no network (testing only)
EMBED_PROVIDER=openrouter
EMBED_MODEL=perplexity/pplx-embed-v1-4b
EMBED_BASE_URL=
EMBED_API_KEY=
# Texts per embedding request. The single biggest lever against a requests-per-minute rate limit:
# doubling this halves the number of calls a bulk ingest makes. Raise it until the provider starts
# rejecting oversized bodies (64 is comfortable on most hosted embedders).
EMBED_BATCH_SIZE=16
# Fire a duplicate embedding request if the first stalls past this many ms (0 disables). Stands
# itself down for a minute after any 429 -- a rate-limited provider is slow, which is exactly what
# fires the hedge, so hedging into one only doubles the request rate.
EMBED_HEDGE_MS=15000
EMBED_TIMEOUT_MS=60000
# Retries per batch on a 429 or a 5xx, honouring Retry-After and otherwise backing off
# exponentially with jitter. A 401/402/400 is never retried -- it will not pass with time.
EMBED_MAX_RETRIES=5
# Minimum gap between embedding requests, in ms. 0 = as fast as they complete. Raise it only when a
# key's limit is low enough that backoff is spending more time waiting than working; 1200 is roughly
# 50 requests a minute.
EMBED_MIN_INTERVAL_MS=0
