# Noodlr Memory service configuration. Copy to ".env" and edit.
# ".env" is gitignored. Never commit real keys.

# --- server ---
# Bind address. Keep 127.0.0.1 unless you intentionally expose it on a trusted LAN.
# Ignored when NOODLR_MEMORY_SOCKET is set.
NOODLR_MEMORY_HOST=127.0.0.1
NOODLR_MEMORY_PORT=3010
# Optional: listen on a Unix domain socket instead of TCP (recommended behind nginx —
# nothing binds a network port). When set, HOST/PORT are ignored. The proxy user must be
# able to connect: keep the socket dir traversable and add that user to this service's group
# (mode 660), or use 666. systemd RuntimeDirectory=noodlr-memory gives you /run/noodlr-memory.
# NOODLR_MEMORY_SOCKET=/run/noodlr-memory/noodlr-memory.sock
# NOODLR_MEMORY_SOCKET_MODE=660
# Shared secret. The Foundry module must send this as the x-noodlr-secret header.
# STRONGLY recommended. Leave blank ONLY for isolated local testing.
NOODLR_MEMORY_SECRET=
# Max request body size in MB (ingestion payloads can be large).
NOODLR_MEMORY_MAX_BODY_MB=32

# --- vector store backend: lancedb | vectra | qdrant | chroma ---
# lancedb = embedded, in-process (no external service, no Python). Recommended default.
#           Writes Lance files under LANCEDB_URI. Uses the @lancedb/lancedb native module.
# vectra  = zero external service, JSON files under DATA_DIR (tiny/simple fallback).
# qdrant  = needs a running/hosted Qdrant (QDRANT_URL).
# chroma  = needs a running Chroma server (CHROMA_URL).
VECTOR_BACKEND=lancedb
NOODLR_MEMORY_DATA_DIR=./data

# LanceDB data directory. Leave unset to keep everything self-contained under
# <DATA_DIR>/lancedb (recommended — one folder to back up, created automatically).
# Only set this to point at an external/existing store. noodlr-memory must be the SOLE
# writer of whatever directory you use (don't also run a separate LanceDB server on it).
# LANCEDB_URI=/opt/lancedb_data

CHROMA_URL=http://localhost:8000
# CHROMA_AUTH_TOKEN=

QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# --- default embedding provider (can be overridden per request by the module) ---
# openrouter   -> https://openrouter.ai/api/v1 (+ EMBED_API_KEY)
# custom       -> any OpenAI-compatible /v1/embeddings (Ollama, vLLM, llama.cpp, LM Studio)
#                 set EMBED_BASE_URL (e.g. http://localhost:11434/v1) and EMBED_MODEL
# transformers -> fully local, in-process (Transformers.js). No external server or key.
#                 Needs the optional @huggingface/transformers dep; EMBED_MODEL is a
#                 HuggingFace id (default Xenova/all-MiniLM-L6-v2), downloaded + cached once.
# mock         -> deterministic local vectors, no network (testing only)
EMBED_PROVIDER=openrouter
EMBED_MODEL=perplexity/pplx-embed-v1-4b
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_BATCH_SIZE=16
# Fire a duplicate embedding request if the first stalls past this many ms (0 disables).
EMBED_HEDGE_MS=15000
EMBED_TIMEOUT_MS=60000
